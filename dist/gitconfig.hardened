# Managed by susanbdev/dotagent — Zero-Trust Global Git Hardening
# Eliminates malicious .git/hooks, fsmonitor RCE, filter/textconv RCE,
# submodule traversal traps, and local/ext protocol confused-deputy attacks.

[core]
	hooksPath = /dev/null
	fsmonitor = false
	pager = cat
	symlinks = false
	autocrlf = input

[protocol]
	allow = https

[protocol "file"]
	allow = never

[protocol "ext"]
	allow = never

[protocol "git"]
	allow = never

[submodule]
	recurse = false
	fetchJobs = 0

[transfer]
	fsckObjects = true

[fetch]
	fsckObjects = true

[receive]
	fsckObjects = true

[filter "lfs"]
	process =
	clean =
	smudge =
	required = false
