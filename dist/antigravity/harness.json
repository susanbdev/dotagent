{
  "schema": "dotagent.antigravity.v2",
  "profile_id": "coding-agent",
  "autoMemoryEnabled": false,
  "shellWrapper": "agent-guard-sh",
  "mediatingSidecar": [
    "agent-guard",
    "mcp-gateway"
  ],
  "stopReceiptVerify": [
    "dotagent",
    "verify-receipt"
  ],
  "budgets": {
    "maxSliceLines": 150,
    "maxRawFileBytes": 24576,
    "maxTurnTokens": 16000,
    "subagentAirlockMaxTokens": 200,
    "maxDirectDiscoveryCalls": 4
  },
  "subagents": {
    "research-airlock": {
      "baseType": "research",
      "enableWriteTools": false,
      "enableSubagentTools": false,
      "enableMcpTools": false,
      "workspace": "inherit",
      "maxWalkDepth": 2,
      "maxReturnTokens": 200
    }
  },
  "mcpServers": {
    "susanbdev": {
      "url": "https://mcp.zt.susanb.dev/mcp"
    }
  }
}
