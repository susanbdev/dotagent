{
  "dotagent-guard": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "agent-guard antigravity-hook SessionStart",
        "timeout": 10
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "agent-guard antigravity-hook PreInvocation",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "agent-guard antigravity-hook PreToolUse",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "agent-guard antigravity-hook PostToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "agent-guard antigravity-hook PostInvocation",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "agent-guard antigravity-hook Stop",
        "timeout": 15
      }
    ]
  }
}
