{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "agent-guard user-prompt"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "agent-guard pre-tool"
      }
    ],
    "afterShellExecution": [
      {
        "command": "agent-guard post-tool"
      }
    ],
    "beforeReadFile": [
      {
        "command": "agent-guard pre-tool"
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "agent-guard pre-tool"
      }
    ],
    "afterMCPExecution": [
      {
        "command": "agent-guard post-tool"
      }
    ],
    "preCompact": [
      {
        "command": "agent-guard pre-compact"
      }
    ],
    "afterFileEdit": [
      {
        "command": "agent-guard post-edit"
      }
    ],
    "stop": [
      {
        "command": "agent-guard on-stop"
      }
    ]
  }
}
